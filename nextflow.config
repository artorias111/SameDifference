params {
    stage = null
    samplesheet = null
    ref = null
    ref_name = null
    outdir = 'results'
    fastp_env = '/data2/work/local/miniconda/envs/fastp'
    bams = null
    chroms = null
}

process {
    withLabel: 'process_low' {
        cpus = 8
        memory = 8.GB
    }
    withLabel: 'process_medium' {
        cpus = 16
        memory = 32.GB
    }
    withLabel: 'process_high' {
        cpus = 48
        memory = 256.GB
    }

    withName: 'TRIM_READS' {
        container = 'quay.io/biocontainers/fastp:1.3.6--h43da1c4_0'
        publishDir = [path: { "${params.outdir}/fastp" }, mode: 'copy', pattern: '*.fastp.{json,html}']
    }

    withName: 'SEQKIT_STATS' {
        container = 'quay.io/biocontainers/seqkit:2.14.0--hb192632_0'
        publishDir = [path: { "${params.outdir}/seqkit" }, mode: 'copy']
    }

    withName: 'PREP_REFERENCE' {
        container = 'community.wave.seqera.io/library/bwa-mem2_htslib_samtools:db98f81f55b64113'
        publishDir = [path: { "${params.outdir}/reference" }, mode: 'copy']
    }

    withName: 'MAP' {
        container = 'community.wave.seqera.io/library/bwa-mem2_htslib_samtools:db98f81f55b64113'
        publishDir = [path: { "${params.outdir}/markdup" }, mode: 'copy', pattern: '*.markdup.txt']
    }

    withName: 'CLIP_OVERLAP' {
        container = 'quay.io/biocontainers/bamutil:1.0.15--h5ca1c30_7'
        publishDir = [path: { "${params.outdir}/clipoverlap" }, mode: 'copy', pattern: '*.clipoverlap.txt']
    }

    withName: 'INDEX_BAM' {
        container = 'quay.io/biocontainers/samtools:1.22.1--h96c455f_0'
        publishDir = [path: { "${params.outdir}/bams" }, mode: 'link']
    }

    withName: 'SAMTOOLS_STATS' {
        container = 'quay.io/biocontainers/samtools:1.22.1--h96c455f_0'
        publishDir = [path: { "${params.outdir}/samtools_stats" }, mode: 'copy']
    }

    withName: 'MOSDEPTH' {
        container = 'quay.io/biocontainers/mosdepth:0.3.14--h87be163_2'
        publishDir = [path: { "${params.outdir}/mosdepth" }, mode: 'copy']
    }

    withName: 'DEPTH_DIST' {
        container = 'quay.io/biocontainers/angsd:0.940--h13024bc_4'
        publishDir = [path: { "${params.outdir}/depth" }, mode: 'copy']
    }
}

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        executor.cpus = 128
        executor.memory = 512.GB
    }
    docker {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64'
    }
    conda {
        conda.enabled = true
        process {
            withName: 'TRIM_READS' {
                conda = params.fastp_env
            }
        }
    }
    test {
        params.samplesheet = "${projectDir}/tests/samplesheet.csv"
        params.ref = "${projectDir}/tests/data/test_ref.fa"
        params.ref_name = 'test_ref'
        params.outdir = 'results_test'
        process.resourceLimits = [cpus: 2, memory: 4.GB]
        params.chroms = "${projectDir}/tests/chroms.txt"
    }
}

manifest {
    nextflowVersion = '!>=26.10.0'
}
